# Trinket Lernix – Konfiguration. Kopieren nach .env und Werte eintragen.
# .env niemals committen.

# Container-Präfix
COMPOSE_PROJECT_NAME=trinket

# === Netzwerk ===
# Port am Docker-Host, auf den der Nginx Proxy Manager zeigt.
APP_PORT=8090
APP_BIND=0.0.0.0
# IP der NPM-VM: nur ihr werden X-Forwarded-For / X-Forwarded-Proto geglaubt.
TRUSTED_PROXIES=192.168.1.20
# Admin-Bereich und Notfall-Login nur aus diesen Netzen (kommagetrennte CIDR-Liste).
ADMIN_IP_ALLOWLIST=192.168.1.0/24

# === Anwendung ===
# production | development  (development nur mit docker-compose.dev.yml)
NODE_ENV=production
# Öffentliche Adresse ohne / am Ende. Daraus entsteht die IServ-Redirect-URI:
#   <PUBLIC_BASE_URL>/auth/iserv/callback
PUBLIC_BASE_URL=https://trinket.lernix.site
# Signiert das Session-Cookie. Erzeugen mit: openssl rand -hex 32
SESSION_SECRET=change-me-please-change-me-please-change-me
SITE_NAME=Trinket Lernix

# === Anmeldung ===
# iserv = Produktion (IServ-SSO + Notfall-Admin), dev = Test-Login ohne IServ (nur Entwicklung)
AUTH_MODE=iserv
# Ohne Anmeldung nur Start-/Login-/Hilfeseite und Einbettungen vorhandener Trinkets; alles andere braucht ein Konto
REQUIRE_LOGIN=true
# IServ-OIDC-Client. Im IServ freigeben: openid profile email iserv:uuid iserv:groups iserv:roles
ISERV_ISSUER=https://rsstu.de
ISERV_CLIENT_ID=
ISERV_CLIENT_SECRET=
# Teilstrings, von denen einer in einer IServ-Rolle oder -Gruppe vorkommen muss → Lehrkraft
ISERV_TEACHER_MARKERS=lehrer,teacher,kollegium
# Lokaler Notfall-Admin (unabhängig von IServ). Wird beim ersten Start angelegt.
BREAKGLASS_EMAIL=
BREAKGLASS_PASSWORD=

# === Aufbewahrung (ADR 0003) ===
# Täglicher Wartungslauf (Dienst "maintenance"): nach dem Schuljahresende werden IServ-Kurse
# archiviert und Trinkets/Abgaben von SuS in den Papierkorb gelegt; nach RETENTION_TRASH_DAYS
# endgültig gelöscht. Probelauf: docker compose exec app node scripts/maintenance.js --dry-run
RETENTION_ENABLED=true
RETENTION_SCHOOL_YEAR_END=07-31
RETENTION_TRASH_DAYS=30

# === Datenbank ===
MONGO_DB=trinket
MONGO_USER=trinket
MONGO_PASSWORD=change-me-please
MONGO_ROOT_PASSWORD=change-me-please-too
